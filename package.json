{
  "name": "cbt-exam-software",
  "private": true,
  "version": "0.0.0",
  "description": "TIMPRIEST EDU offline exam system",
  "author": "TIMPRIEST EDU",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.cjs",
    "dev:full": "npm run server",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win --x64",
    "desktop:roles": "node scripts/build-desktop-roles.cjs",
    "android:sync": "npm run build && cap sync android",
    "android:roles": "node scripts/build-android-roles.cjs",
    "android:creator": "node scripts/build-android-roles.cjs creator",
    "android:prep": "node scripts/build-android-roles.cjs prep",
    "android:ambassador": "node scripts/build-android-roles.cjs ambassador",
    "android:open": "cap open android",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.13.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capgo/capacitor-native-biometric": "^7.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "edu.timpriest.cbt",
    "productName": "TIMPRIEST EDU",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "priesthoodnation001-beep",
        "repo": "CBT-Exam-Platform"
      }
    ]
  }
}
